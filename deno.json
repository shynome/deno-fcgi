{
  "name": "@shynome/deno-fcgi",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts"
  },
  "publish": {
    "include": ["README.md", "LICENSE", "src/**/*.ts"]
  },
  "tasks": {
    "dev": "deno run --allow-read --allow-write=/tmp --allow-net --allow-env --unstable-worker-options src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --unstable-worker-options tests/"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
